{
  "name": "broadcaster",
  "version": "0.1.0",
  "description": "Node app that generates and hosts HTTP Live Streams from local content using FFMpeg and ExpressJS.",
  "main": "Broadcaster.js",
  "scripts": {
    "start": "node Broadcaster.js",
    "test": "node --test",
    "test:playback": "node scripts/playback-smoke.cjs",
    "test:unit": "node --test test/*.test.js",
    "build:frontend": "cd Webapp && npm run build",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop broadcaster",
    "pm2:restart": "pm2 restart broadcaster",
    "pm2:delete": "pm2 delete broadcaster",
    "pm2:logs": "pm2 logs broadcaster",
    "pm2:monit": "pm2 monit"
  },
  "author": "Ted Charles",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0"
  },
  "overrides": {
    "path-to-regexp": ">=8.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theodorecharles/Broadcaster.git"
  },
  "bugs": {
    "url": "https://github.com/theodorecharles/Broadcaster/issues"
  },
  "homepage": "https://github.com/theodorecharles/Broadcaster#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
